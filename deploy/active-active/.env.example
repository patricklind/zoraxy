# Every image must be replaced with a version and verified sha256 digest.
POSTGRES_IMAGE=postgres:17-alpine@sha256:REPLACE_WITH_VERIFIED_DIGEST
HAPROXY_IMAGE=haproxy:3.2-alpine@sha256:REPLACE_WITH_VERIFIED_DIGEST
ZORAXY_IMAGE=zoraxydocker/zoraxy:3.3.5@sha256:REPLACE_WITH_VERIFIED_DIGEST
ZORAXY_NODE_ID=REPLACE_WITH_NODE_UUID
ZORAXY_CONFIGSTORE_MODE=data-plane
ZORAXY_CONFIGSTORE_MIGRATION_MODE=verify
ZORAXY_CONFIGSTORE_DSN_FILE=/run/secrets/zoraxy-configstore-dsn
ZORAXY_CONFIGSTORE_POLL_INTERVAL=1s
ZORAXY_CONFIGSTORE_STARTUP_TIMEOUT=10s
