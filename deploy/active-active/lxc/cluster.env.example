# Use exactly one mode: control-plane, data-plane or certificate-controller.
ZORAXY_CONFIG_BACKEND=postgresql
ZORAXY_CONFIGSTORE_MODE=data-plane
ZORAXY_NODE_ROLE=data-plane
ZORAXY_CONFIGSTORE_MIGRATION_MODE=verify
ZORAXY_CONFIGSTORE_DSN_FILE=/etc/zoraxy/configstore.dsn
ZORAXY_CONFIGSTORE_CERTIFICATE_KEY_FILE=/etc/zoraxy/certificate.key
ZORAXY_CONFIGSTORE_POLL_INTERVAL=1s
ZORAXY_CONFIGSTORE_STARTUP_TIMEOUT=10s
