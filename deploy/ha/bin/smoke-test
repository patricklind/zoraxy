#!/bin/sh
set -eu

: "${ZORAXY_VIP:?Set ZORAXY_VIP}"
management_port="${ZORAXY_MANAGEMENT_PORT:-8000}"
timeout_seconds="${ZORAXY_FAILOVER_TIMEOUT:-60}"

deadline=$(( $(date +%s) + timeout_seconds ))
while [ "$(date +%s)" -lt "$deadline" ]; do
  if curl --fail --silent --show-error --max-time 3 \
    "http://${ZORAXY_VIP}:${management_port}/health/ready" >/dev/null; then
    echo "Zoraxy is ready on ${ZORAXY_VIP}"
    exit 0
  fi
  sleep 2
done

echo "Zoraxy did not become ready within ${timeout_seconds}s" >&2
exit 1
