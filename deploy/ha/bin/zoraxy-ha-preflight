#!/bin/sh
set -eu

: "${ZORAXY_IMAGE:?ZORAXY_IMAGE is required}"

case "$ZORAXY_IMAGE" in
  *@sha256:????????????????????????????????????????????????????????????????) ;;
  *) echo "ZORAXY_IMAGE must be pinned by a full sha256 digest" >&2; exit 1 ;;
esac

mountpoint -q /srv/zoraxy || {
  echo "/srv/zoraxy is not a mounted DRBD filesystem" >&2
  exit 1
}

test -w /srv/zoraxy || {
  echo "/srv/zoraxy is not writable" >&2
  exit 1
}

docker image inspect "$ZORAXY_IMAGE" >/dev/null
docker compose --env-file /etc/zoraxy-ha/zoraxy.env -f /etc/zoraxy-ha/compose.yaml config --quiet
