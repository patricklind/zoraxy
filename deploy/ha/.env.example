# Copy to /etc/zoraxy-ha/zoraxy.env on both nodes.
# The digest is mandatory: tags such as latest are intentionally rejected.
ZORAXY_IMAGE=zoraxydocker/zoraxy:3.3.5@sha256:REPLACE_WITH_VERIFIED_DIGEST
# Bind on the active node; restrict port 8000 to the management CIDR in the host firewall.
ZORAXY_MANAGEMENT_IP=0.0.0.0
ZORAXY_MANAGEMENT_PORT=8000
TZ=Europe/Copenhagen
